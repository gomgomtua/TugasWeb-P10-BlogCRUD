APP_NAME="Blog CRUD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database: MySQL (Laragon / XAMPP) ---------------------------------
# Buat dulu database `blog_db` di phpMyAdmin (utf8mb4_unicode_ci)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blog_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Upload gambar disimpan di disk "public" (storage/app/public) -> php artisan storage:link
FILESYSTEM_DISK=local

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
